# Auto detect text files and perform LF normalization
* text=auto

# Preserve executable source bytes in Windows and nested validation clones.
*.py text eol=lf
/src/pyaedt_motor/diagnostic_batch_ownership.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.sh text eol=lf
/configs/ipmsm_7p5kw.json text eol=lf
/configs/material_m19_29g_reference_y2.json text eol=lf

# These source files are bound by SHA256 in sealed IPMSM v2 evidence manifests.
/build_ipmsm_untouched_test_plan.py text eol=lf
/confirm_ipmsm_v2_model_families.py text eol=lf
/diagnose_ipmsm_v2_model_families.py text eol=lf
/train_ipmsm_lightgbm.py text eol=lf

# Historical untracked scripts retain exact bytes, including Markdown string spacing.
legacy/final_design_2026_07/** -text -whitespace
legacy/reference_artifacts_2026_07/** -text -whitespace
legacy/replay_analysis/** -text -whitespace

# Preserve the saved Native fixture bytes used in the mesh verification evidence.
/tests/fixtures/ipmsm_saved950_mesh_operations.json -text -whitespace

# Cold contracts retain their original LF/CRLF bytes and immutable hash inputs.
legacy/v4r5_native_contract_2026_07/** -text -whitespace

# Keep the published, SHA-sealed experiment figures byte-identical to their source.
/docs/experiments/2026-11-01_public_cycles/*.svg -text
/docs/experiments/2026-11-01_public_spatial/** -text -whitespace

# Portable execution fixtures preserve their sealed raw and provenance bytes.
/tests/fixtures/compatibility_legacy/** -text -whitespace
/tests/fixtures/family_origin307b/** -text -whitespace
/tests/fixtures/install_vector307b/** -text -whitespace
/tests/fixtures/owned_cli_upstream/** -text -whitespace
/tests/fixtures/public_cli_p3_numeric/** -text -whitespace

# Preserve the exact measured diagnostic CSV and generated figure bytes.
/docs/experiments/2026-11-01_energy_balance/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/docs/experiments/2026-11-01_energy_balance/*.svg -text -whitespace

# Preserve measured air-gap diagnostics and their standalone figure bytes.
/docs/experiments/2026-11-01_airgap_stress/*.csv -text -whitespace
/docs/experiments/2026-11-01_airgap_stress/*.svg -text -whitespace
